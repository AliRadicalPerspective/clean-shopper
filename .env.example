# Supabase — copy to .env.local and fill in.
# Both values are safe to expose in a browser bundle; row-level security is
# what protects the data. Never put the service_role key in here.
#
# Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only — needed by `npm run seed:safer-choice` to write the EPA
# reference table past row-level security. Deliberately NOT prefixed VITE_, so
# Vite will never inline it into the browser bundle. Put this in .env (not
# .env.local) and never commit it.
#
# Dashboard → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=
